# The lab content is read by Linux containers: keep it LF on every checkout,
# Windows included. With CRLF, a code fence such as "```dockerfile save-as=Dockerfile"
# ends in a carriage return, and the Labspace writes "Dockerfile\r" next to the
# real Dockerfile instead of replacing it.
labspace/**      text=auto eol=lf
project/**       text=auto eol=lf
simspace/labs/** text=auto eol=lf
